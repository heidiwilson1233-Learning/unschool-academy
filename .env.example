# Unschool Academy — environment template
# Copy to .env.local and fill in. Never commit real keys.

# ── Supabase (auth + Postgres). Required for real sign-in, attempts, families.
# Create a project at https://supabase.com/dashboard, then run supabase/schema.sql
# in the SQL editor. Until these are set, auth pages show "not connected".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used for admin reads/writes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (test mode). Required for checkout.
# Get test keys at https://dashboard.razorpay.com/app/keys (Test Mode).
# Live billing stays OFF until the user explicitly approves it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email (transactional). Set when a provider + verified domain are chosen.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ── Credentials (practice records). Signs /credentials verification links.
# Set a long random value in production — without it the app falls back to a
# dev secret that ships in the repo, and issued links would be forgeable.
CREDENTIAL_SECRET=
